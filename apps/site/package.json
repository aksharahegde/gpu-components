{
  "name": "@gpu-components/site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Public project site for gpu-components",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit --pretty",
    "smoke": "vite build --ssr scripts/smoke.tsx --outDir .smoke --logLevel warn && node .smoke/smoke.js",
    "check": "npm run typecheck && npm run smoke && npm run build"
  },
  "dependencies": {
    "@stylexjs/stylex": "^0.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@stylexjs/unplugin": "^0.19.0",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
