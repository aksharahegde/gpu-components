{
  "name": "gpu-component-runtime",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:registry",
    "typecheck:registry": "tsc -p registry/tsconfig.json --pretty",
    "test": "npm run test --workspaces --if-present && npm run test:registry",
    "test:registry": "node --experimental-strip-types --import ./registry/timeline/test/register.mjs --test registry/timeline/*.test.ts registry/timeline/*.test.tsx"
  }
}
