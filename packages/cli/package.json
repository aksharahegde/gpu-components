{
  "name": "@gpuc/cli",
  "version": "0.1.1",
  "type": "module",
  "description": "Copy GPU component source into your repo. The runtime stays an npm dependency.",
  "license": "MIT",
  "author": "Akshara Hegde",
  "homepage": "https://gpuc.akshara.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aksharahegde/gpu-components.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/aksharahegde/gpu-components/issues",
  "bin": {
    "gpuc": "./bin/gpuc.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --pretty",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "build": "tsc -p tsconfig.build.json && node scripts/buildRegistry.mjs",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "files": [
    "bin",
    "dist",
    "registry.json",
    "components",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
