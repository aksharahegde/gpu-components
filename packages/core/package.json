{
  "name": "@gpuc/core",
  "version": "0.1.0",
  "type": "module",
  "description": "Framework-independent GPU runtime for gpu-components, built on vgpu.",
  "license": "MIT",
  "author": "Akshara Hegde",
  "homepage": "https://gpuc.akshara.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aksharahegde/gpu-components.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/aksharahegde/gpu-components/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit --pretty",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "dependencies": {
    "vgpu": "^0.3.1"
  },
  "devDependencies": {
    "@gpuc/testing": "*",
    "@types/node": "^22.10.2",
    "@webgpu/types": "^0.1.72",
    "typescript": "^5.6.3"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
