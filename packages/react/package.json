{
  "name": "@gpu-components/react",
  "version": "0.1.0",
  "type": "module",
  "description": "React adapter for gpu-components. Owns no GPU state.",
  "license": "MIT",
  "author": "Akshara Hegde",
  "homepage": "https://gpuc.akshara.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aksharahegde/gpu-components.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/aksharahegde/gpu-components/issues",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit --pretty",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@gpu-components/core": "^0.1.0",
    "vgpu": "^0.3.1"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@gpu-components/testing": "*",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@webgpu/types": "^0.1.72",
    "jsdom": "^30.0.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
