{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // The publishable build. `rewriteRelativeImportExtensions` (TypeScript 5.7+) is what makes this
    // possible without touching a single source file: the sources keep their explicit `.ts` import
    // specifiers — which Node's `--experimental-strip-types` test runner requires — and the emitted
    // JavaScript gets `.js`. Before this flag existed the two requirements were in direct conflict.
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "src",
    // The publishable build consumes core as a built package; the source path mappings in
    // tsconfig.json (for typechecking/tests) would pull core/src into this program and break rootDir.
    "paths": {
      "@gpuc/core": ["../core/dist/index.d.ts"],
      "@gpuc/core/*": ["../core/dist/*"]
    },
    "jsx": "react-jsx"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
